{"$id":"zen/stream-json-v1/system-init.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"First line of every agent run. NOTE: the init line has NO uuid (docs/stream-json-v1.md states this explicitly), so uuid is neither required nor forbidden here. mcp_server_errors is only present when MCP config entries were skipped by validation, so it is not required. Unknown fields are allowed (v1 ignore-unknown rule).","properties":{"cwd":{"type":"string"},"folder_trusted":{"type":"boolean"},"mcp_server_errors":{"items":{"additionalProperties":true,"properties":{"name":{"type":"string"},"reason":{"type":"string"}},"required":["name","reason"],"type":"object"},"type":"array"},"mcp_servers":{"items":{"additionalProperties":true,"properties":{"name":{"type":"string"},"status":{"enum":["connected","failed"],"type":"string"}},"required":["name","status"],"type":"object"},"type":"array"},"model":{"type":"string"},"permissionMode":{"enum":["default","acceptEdits","plan","bypassPermissions","dontAsk"],"type":"string"},"session_id":{"minLength":1,"type":"string"},"slash_commands":{"items":{"type":"string"},"type":"array"},"subtype":{"const":"init"},"tools":{"items":{"type":"string"},"type":"array"},"type":{"const":"system"},"v":{"const":1}},"required":["type","v","session_id","subtype","cwd","model","tools","mcp_servers","permissionMode","slash_commands","folder_trusted"],"title":"stream-json v1 system/init record (DRAFT)","type":"object"}