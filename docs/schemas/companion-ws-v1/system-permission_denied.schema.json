{"$id":"zen/stream-json-v1/system-permission_denied.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Emitted when a tool call is denied. A user record with is_error true for the same tool_use_id follows. Unknown fields are allowed (v1 ignore-unknown rule).","properties":{"decision_reason":{"type":"string"},"session_id":{"minLength":1,"type":"string"},"subtype":{"const":"permission_denied"},"tool_name":{"type":"string"},"tool_use_id":{"type":"string"},"type":{"const":"system"},"uuid":{"minLength":1,"type":"string"},"v":{"const":1}},"required":["type","v","session_id","uuid","subtype","tool_name","tool_use_id","decision_reason"],"title":"stream-json v1 system/permission_denied record (DRAFT)","type":"object"}